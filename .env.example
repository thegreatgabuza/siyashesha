# Siyashesha Health Passport - Environment Configuration Template
# In Expo, variables accessible in client-side code must start with EXPO_PUBLIC_

# Environment Mode: 'development' | 'staging' | 'production'
EXPO_PUBLIC_APP_ENV=development

# Backend API Base URL (leave empty or localhost for offline seed mode)
EXPO_PUBLIC_API_URL=http://localhost:3000/api

# Mock Data Toggle: Set to 'true' to use local seed data & AsyncStorage
EXPO_PUBLIC_USE_MOCK_DATA=true

# Public Emergency ICE Web Portal URL (used for emergency QR / sharing links)
EXPO_PUBLIC_EMERGENCY_PORTAL_URL=https://siyashesha-health-passport.lovable.app

# ==========================================
# Clerk Authentication
# ==========================================
# Obtain from Clerk Dashboard: https://dashboard.clerk.com/
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key

# ==========================================
# Supabase (Database & Storage)
# ==========================================
# Obtain from Supabase Project Settings -> API: https://supabase.com/dashboard
EXPO_PUBLIC_SUPABASE_URL=https://bwsarnrbcdrfanhohwwe.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImJ3c2FybnJiY2RyZmFuaG9od3dlIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTI4ODgzODksImV4cCI6MjEwODQ2NDM4OX0.9Kc7l_GI5QS_1kklEo7bfE8mkwfaLpTbKm3RzQDZ3gE
# Storage bucket name for patient medical record uploads and document scans
EXPO_PUBLIC_SUPABASE_STORAGE_BUCKET=medical-records

# ==========================================
# Google Gemini API
# ==========================================
# Obtain from Google AI Studio: https://aistudio.google.com/
EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here
EXPO_PUBLIC_AI_ASSISTANT_PROVIDER=gemini

# ==========================================
# Analytics & Error Tracking (Optional)
# ==========================================
EXPO_PUBLIC_ENABLE_ANALYTICS=false
